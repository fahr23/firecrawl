# Firecrawl API Key (Get from https://firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backtofuture
DB_USER=backtofuture
DB_PASSWORD=back2future
DB_SCHEMA=turkish_financial

# Scraping Configuration
MAX_CONCURRENT_TASKS=10
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2

# Firecrawl Options
FIRECRAWL_WAIT_FOR=3000
FIRECRAWL_TIMEOUT=30000
FIRECRAWL_FORMATS=markdown,html

# LLM Configuration (for sentiment analysis and report analysis)
# Option 1: OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Option 2: Google Gemini (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
# OR use GOOGLE_API_KEY (same as GEMINI_API_KEY)
# GOOGLE_API_KEY=your-gemini-api-key-here

# Option 3: Local LLM (LM Studio, Ollama, etc.)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# YouTube Channel Scraper
# Comma-separated list of channel URLs to scrape (defaults to seed list in config.py)
YOUTUBE_CHANNELS=https://www.youtube.com/@bistyatirimcipsikolojisi/videos
YOUTUBE_DAYS_BACK=7
YOUTUBE_LIMIT_PER_CHANNEL=50
# Preferred transcript languages (comma-separated, auto-generated captions allowed)
YOUTUBE_TRANSCRIPT_LANGUAGES=tr,en

# Proxy Configuration for direct HTTP requests (via ScraperAPI)
# Dashboard: https://dashboard.scraperapi.com/home
# Username is always "scraperapi"; password is your API key
USE_PROXY=true
APP_PROXY_URL=http://proxy-server.scraperapi.com:8001
APP_PROXY_USERNAME=scraperapi
APP_PROXY_PASSWORD=your_scraperapi_api_key_here

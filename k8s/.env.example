# Firecrawl Kubernetes Environment Configuration
# Copy this file to .env and modify values as needed

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432
USE_DB_AUTHENTICATION=false

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379

# Service URLs (internal cluster DNS)
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
HTML_TO_MARKDOWN_SERVICE_URL=http://go-html-to-md-service:8080

# Message Queue
NUQ_RABBITMQ_URL=amqp://rabbitmq:5672

# Worker Configuration
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# API Configuration
HOST=0.0.0.0
PORT=3002
INTERNAL_PORT=3002
EXTRACT_WORKER_PORT=3004
WORKER_PORT=3005
ENV=production
NUQ_WORKER_COUNT=0
HARNESS_STARTUP_TIMEOUT_MS=60000

# Logging
LOGGING_LEVEL=info

# AI/LLM Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=

# Authentication & Security
AUTUMN_SECRET_KEY=
BULL_AUTH_KEY=
TEST_API_KEY=

# External Services (Optional)
SLACK_WEBHOOK_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=
SELF_HOSTED_WEBHOOK_URL=

# Proxy Configuration (Optional)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Search Engine Configuration (Optional)
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# Playwright Service Configuration
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=true
MAX_CONCURRENT_PAGES=10